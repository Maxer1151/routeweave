<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/colorText"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_app_version"
                style="@style/Pill"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_blue"
                android:text="@string/app_version"
                android:textColor="@color/colorAccent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <!-- Hero-статус -->
        <LinearLayout
            style="@style/HeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/colorMuted" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    style="@style/Pill"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_gray"
                    android:text="@string/hero_badge_wait"
                    android:textColor="@color/colorMuted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HeroLabel"
                    android:text="@string/label_network" />

                <TextView
                    android:id="@+id/tv_hero_network"
                    style="@style/HeroValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HeroLabel"
                    android:text="@string/label_vpn" />

                <TextView
                    android:id="@+id/tv_hero_vpn"
                    style="@style/HeroValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HeroLabel"
                    android:text="@string/label_rule" />

                <TextView
                    android:id="@+id/tv_hero_rule"
                    style="@style/HeroValue"
                    android:text="@string/value_dash"
                    android:textColor="@color/colorAccent" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="@color/colorStroke" />

            <TextView
                style="@style/SmallLabel"
                android:text="@string/label_last" />

            <TextView
                android:id="@+id/tv_hero_last"
                style="@style/BodyText"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/value_dash"
                android:textColor="@color/colorTextSecondary" />

            <Button
                android:id="@+id/btn_apply"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_apply" />
        </LinearLayout>

        <!-- Автопереключение -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_title" />

            <Switch
                android:id="@+id/sw_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auto_switch"
                android:textColor="@color/colorText"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_monitor_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/monitor_stopped"
                android:textColor="@color/colorMuted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/auto_summary"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_trusted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorAccent"
                android:text="@string/trusted_title"
                android:textColor="@color/colorText"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Доверенные Wi-Fi -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_trusted_wifi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/trusted_wifi_summary"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_ssid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/value_dash"
                    android:textColor="@color/colorText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_ssid_status"
                    style="@style/Pill"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_amber"
                    android:text="@string/ssid_unavailable"
                    android:textColor="@color/colorAmber" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_trusted_ssids"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:hint="@string/trusted_list_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:minLines="3"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tv_ssid_count"
                style="@style/SmallLabel"
                android:layout_marginTop="6dp"
                android:text="@string/value_dash" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_current"
                    style="@style/ButtonSoft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_add_current" />

                <Button
                    android:id="@+id/btn_save_ssids"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_save_ssids" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_ssid_permission"
                style="@style/ButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_ssid_permission" />

            <LinearLayout
                style="@style/CardSoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    style="@style/HintText"
                    android:text="@string/trusted_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- Exit node -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_exit" />

            <Switch
                android:id="@+id/sw_exit_manage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/exit_manage_title"
                android:textColor="@color/colorText"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/exit_manage_summary"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <TextView
                style="@style/SmallLabel"
                android:text="@string/exit_name_label" />

            <EditText
                android:id="@+id/et_exit_name"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/exit_name_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/SmallLabel"
                android:layout_marginTop="10dp"
                android:text="@string/exit_ip_label" />

            <EditText
                android:id="@+id/et_exit_ip"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/exit_ip_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true" />

            <CheckBox
                android:id="@+id/cb_exit_allow_lan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/colorAccent"
                android:text="@string/exit_allow_lan_title"
                android:textColor="@color/colorText"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cb_exit_watchdog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorAccent"
                android:text="@string/exit_watchdog_title"
                android:textColor="@color/colorText"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_exit_off"
                    style="@style/ButtonDanger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_exit_off" />

                <Button
                    android:id="@+id/btn_exit_on"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_exit_on" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_exit_state"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/value_dash" />

            <LinearLayout
                style="@style/CardSoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    style="@style/HintText"
                    android:text="@string/exit_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- Правила -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_rules" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/colorGreen" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/rule_wifi_trusted"
                    android:textColor="@color/colorText"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/colorAccent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/rule_wifi_untrusted"
                    android:textColor="@color/colorText"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/colorPurple" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/rule_mobile_wdtt"
                    android:textColor="@color/colorText"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:background="@color/colorStroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ts_on"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_tailscale_on" />

                <Button
                    android:id="@+id/btn_ts_off"
                    style="@style/ButtonDanger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_tailscale_off" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_wdtt_on"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_wdtt_on" />

                <Button
                    android:id="@+id/btn_wdtt_off"
                    style="@style/ButtonDanger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_wdtt_off" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_ts"
                    style="@style/ButtonSoft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_open_tailscale" />

                <Button
                    android:id="@+id/btn_open_wdtt"
                    style="@style/ButtonSoft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_open_wdtt" />
            </LinearLayout>
        </LinearLayout>

        <!-- Диагностика -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/section_diagnostics" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/diag_tailscale" />

                <TextView
                    android:id="@+id/tv_diag_tailscale"
                    style="@style/RowValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/diag_wdtt" />

                <TextView
                    android:id="@+id/tv_diag_wdtt"
                    style="@style/RowValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/diag_notifications" />

                <TextView
                    android:id="@+id/tv_diag_notif"
                    style="@style/RowValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/diag_battery" />

                <TextView
                    android:id="@+id/tv_diag_battery"
                    style="@style/RowValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/diag_ssid" />

                <TextView
                    android:id="@+id/tv_diag_ssid"
                    style="@style/RowValue"
                    android:text="@string/value_dash" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_battery"
                style="@style/ButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_configure" />
        </LinearLayout>

        <!-- Настройка -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/section_setup" />

            <TextView
                style="@style/HintText"
                android:text="@string/setup_text" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/footer_version"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
