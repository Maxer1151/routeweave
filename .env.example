# ============================================================
#  Routeweave — конфигурация (копируется в /etc/routeweave/.env)
#  Установщик создаёт файл с правами 0640 root:routeweave: читать
#  может только root и сервисный пользователь routeweave (панель).
#  Все значения — в двойных кавычках. Внутри кавычек экранируются
#  только \ и " (как в shell). Секреты генерирует установщик, если
#  их нет в файле; PANEL_PASS обязателен — без него панель не стартует.
#  Не коммитьте этот файл с настоящими секретами.
#  После правки: sudo systemctl restart mihomo zapret-nfqws routeweave-panel
#
#  Переменные времени установки (ZAPRET_REF, INSTALL_WDTT, INSTALL_TGWS,
#  MIHOMO_SHA256, ZASHBOARD_SHA256) задаются в окружении перед запуском
#  sudo ./install.sh и в этом файле не читаются — см. ./install.sh --help.
# ============================================================

# --- Сеть -----------------------------------------------------------
# LAN-интерфейс сервера (единственная NIC, смотрит в локалку/роутер)
LAN_IFACE="eth0"
# IP сервера в локалке (должен быть статичным / зарезервирован в DHCP)
SERVER_IP="192.168.1.10"

# --- Socks/https-прокси для гео-блокировок (ОПЦИОНАЛЬНО) ------------
# Форматы: socks5h://user:pass@host:port  (имя резолвит прокси),
#          socks5://user:pass@host:port, socks://..., http://..., https://...
# ПУСТО = гео-домены пойдут напрямую (без обхода гео)
SOCKS_URL=""

# --- Telegram / tg-ws-proxy (ОПЦИОНАЛЬНО, INSTALL_TGWS=yes) ----------
# Секрет MTProto-прокси (генерируется установщиком).
# Итоговый секрет для клиентов: docker logs routeweave-tgwsproxy
TG_SECRET=""
# Домен CF Worker, привязанный к Cloudflare.
# Пусто = CF Worker не используется.
BASE_DOMAIN=""
# Домен CF Worker для tg-ws-proxy (обычно совпадает с BASE_DOMAIN)
TG_CF_WORKER_DOMAIN=""
# IP/хост для tg://-ссылки; используется панелью для сборки ссылки.
# Пусто = SERVER_IP.
TG_LINK_IP=""

# --- WDTT-Plus (ОПЦИОНАЛЬНО, INSTALL_WDTT=yes) ----------------------
# Подсеть WireGuard-клиентов WDTT (VPN для Android); получает ту же
# политику маршрутизации/фаервола, что и LAN.
WG_SUBNET="10.66.66.0/24"

# --- Панель ---------------------------------------------------------
PANEL_PORT="8080"
PANEL_USER="admin"
# Обязателен: генерируется установщиком; пусто = панель не стартует
PANEL_PASS=""
# Секрет API mihomo (external-controller) — нужен и для zashboard
MIHOMO_SECRET=""

# --- Поведение ------------------------------------------------------
# Резать UDP/443 (QUIC): yes — браузеры/приложения откатятся на TCP.
QUIC_DROP="yes"
# Доп. строки в fake-ip-filter (домены, которым нужен реальный IP):
# через запятую, например: +.bank.example,+.camera.local
FAKEIP_EXTRA=""

# --- Целостность загрузок (install-time, НЕ читаются из этого файла) --
# Если апстрим не публикует рядом с архивом файл <url>.sha256, задайте
# ожидаемую сумму вручную перед запуском установщика. Иначе установщик
# предупредит, что целостность загрузки НЕ проверена.
#   sudo MIHOMO_SHA256=<hex> ZASHBOARD_SHA256=<hex> ./install.sh
MIHOMO_SHA256=""
ZASHBOARD_SHA256=""
