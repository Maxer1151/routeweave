# ============================================================
#  Routeweave — конфигурация (копируется в /etc/homegateway/.env)
#  Файл создаётся с chmod 600. Секреты генерирует установщик и
#  не печатает их в консоль. Не коммитьте этот файл.
#  После правки: sudo systemctl restart mihomo zapret-nfqws homegw-panel
# ============================================================

# --- Сеть -----------------------------------------------------------
# LAN-интерфейс сервера (единственная NIC, смотрит в локалку/роутер)
LAN_IFACE=eth0
# IP сервера в локалке (должен быть статичным / зарезервирован в DHCP)
# Пример:
SERVER_IP=192.168.1.10

# --- Socks/https-прокси для гео-блокировок (ОПЦИОНАЛЬНО) ------------
# Форматы: socks5://user:pass@host:port  или  http://user:pass@host:port
# ПУСТО = гео-домены пойдут напрямую (без обхода гео)
SOCKS_URL=

# --- Telegram / tg-ws-proxy (ОПЦИОНАЛЬНО, INSTALL_TGWS=yes) ----------
# Секрет MTProto-прокси (генерируется установщиком).
# Итоговый секрет для клиентов: docker logs homegw-tgwsproxy
TG_SECRET=
# Домен CF Worker, привязанный к Cloudflare.
# Пусто = CF Worker не используется.
BASE_DOMAIN=
# Домен CF Worker для tg-ws-proxy (обычно совпадает с BASE_DOMAIN)
TG_CF_WORKER_DOMAIN=
# IP/хост для tg://-ссылки (пусто = SERVER_IP)
TG_LINK_IP=

# --- WDTT-Plus (ОПЦИОНАЛЬНО, INSTALL_WDTT=yes) ----------------------
# Подсеть WireGuard-клиентов WDTT; получает ту же политику, что LAN
WG_SUBNET=10.66.66.0/24

# --- Панель ---------------------------------------------------------
PANEL_PORT=8080
PANEL_USER=admin
# Генерируется установщиком; пусто = панель не стартует
PANEL_PASS=
# Секрет API mihomo (external-controller) — нужен и для zashboard
MIHOMO_SECRET=

# --- Поведение ------------------------------------------------------
# Резать UDP/443 (QUIC): yes — браузеры/приложения откатятся на TCP.
QUIC_DROP=yes
# Доп. строки в fake-ip-filter (домены, которым нужен реальный IP):
# через запятую, например: +.bank.example,+.camera.local
FAKEIP_EXTRA=
