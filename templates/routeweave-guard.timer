[Unit]
Description=Routeweave: периодическая проверка инвариантов маршрутизации

[Timer]
# Первый запуск через минуту после активации таймера, далее раз в минуту от
# конца предыдущего запуска (OnUnitActiveSec считается от активации юнита,
# поэтому долгая починка не наслаивается сама на себя).
#
# OnActiveSec, а не OnBootSec: при установке и обновлении таймер включают
# сразу после `systemctl restart mihomo`, и при OnBootSec (отсчёт от загрузки,
# она давно прошла) сторож стартовал бы немедленно — пока mihomo ещё создаёт
# таблицу inet mihomo, — и зря перезапускал бы его второй раз подряд.
# OnActiveSec отсчитывает минуту от включения таймера, поэтому сторож впервые
# заходит на уже устоявшийся шлюз, а после загрузки системы даёт те же 60 с.
OnActiveSec=60
OnUnitActiveSec=60
AccuracySec=5s
# Persistent=no: сторож не нужно «догонять» после простоя — он смотрит только
# текущее состояние, а пропущенный запуск ничего не значит.
Persistent=no

[Install]
WantedBy=timers.target
