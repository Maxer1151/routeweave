[Unit]
Description=Routeweave: монитор WDTT (счётчики wdtt0 и сессии tgws)

[Timer]
# OnActiveSec, а не OnBootSec: интерфейс wdtt0 появляется после старта
# wdtt.service, а таймер включается установщиком уже после установки WDTT.
# Отсчёт от активации таймера даёт первый замер через минуту на устоявшемся
# интерфейсе, а после загрузки системы — те же 60 секунд.
OnActiveSec=60
# Раз в минуту от конца предыдущего запуска: дельты счётчиков считаются между
# соседними строками, поэтому запуск не должен наслаиваться сам на себя.
OnUnitActiveSec=60
# 5 секунд допуска: точность до секунды монитору не нужна, а редкие
# пробуждения экономят диск и CPU.
AccuracySec=5s
# Persistent=no: пропущенный замер не «догоняется» — дельта за пропуск
# всё равно потеряна, а пачка запусков при загрузке только мешает.
Persistent=no

[Install]
WantedBy=timers.target
