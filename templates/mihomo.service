# mihomo при старте пересоздаёт policy-routing (таблица 2022, правила
# 9001/9002), поэтому правило WAN-доступа (priority 8993) переутверждается
# после каждого (пере)запуска. Префикс "-" в ExecStartPost: на старых
# установках без fw-wan.sh юнит не должен падать.
[Unit]
Description=Routeweave mihomo (transparent proxy core)
Documentation=https://wiki.metacubex.one
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
LimitNOFILE=1048576
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStart=/usr/local/bin/mihomo -d /etc/routeweave
ExecStartPost=-/etc/routeweave/fw-wan.sh start
WorkingDirectory=/etc/routeweave
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
# Hardening (L-09). Зачем именно так, чтобы не «оптимизировать» обратно:
#   - ProtectSystem=strict делает /usr, /boot, /etc read-only; mihomo читает
#     конфиг из /etc/routeweave и пишет туда кэш/geo-файлы, поэтому этот
#     каталог и /run (lock-файл fw-wan.sh) открыты через ReadWritePaths;
#   - NoNewPrivileges здесь НЕ ставится: mihomo получает capabilities через
#     AmbientCapabilities, а с NoNewPrivileges ambient-набор сбрасывается при
#     exec и TUN/iptables перестают работать;
#   - PrivateDevices НЕ ставится: mihomo обязан открыть /dev/net/tun;
#   - AF_NETLINK нужен для netlink (ip rule/route), AF_UNIX — для локального
#     API/логов, AF_INET/AF_INET6 — для проксирования.
ProtectSystem=strict
ReadWritePaths=/etc/routeweave /run
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
