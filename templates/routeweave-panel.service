# Routeweave: веб-панель (FastAPI/uvicorn) от непривилегированного пользователя.
#
# Почему User=routeweave и не root:
#   панели root не нужен. Все привилегированные действия (restart mihomo /
#   zapret-nfqws / routeweave-panel, обновление списков, tg-ws-proxy) она
#   делает через `sudo -n` строго по allowlist из
#   /etc/sudoers.d/routeweave-panel — там перечислены конкретные команды, без
#   wildcard. Если панель скомпрометируют (RCE в веб-морде), атакующий
#   получит только эти команды, а не root.
#
# Почему CapabilityBoundingSet непустой:
#   /usr/bin/sudo — setuid-root бинарник, и при exec ядро поднимает его
#   capabilities только в пределах bounding set процесса: чего в наборе нет,
#   того sudo не получит. С пустым набором sudo не может сменить пользователя
#   и падает с «unable to set groups» / «could not restore to saved user id»
#   (особенно в sudo-rs на Ubuntu 25.10+/26.04), поэтому кнопки панели
#   перестают работать. Перечисленный набор — минимум для elevate и работы от
#   другого пользователя: CAP_SETUID, CAP_SETGID, CAP_CHOWN,
#   CAP_DAC_OVERRIDE, CAP_DAC_READ_SEARCH, CAP_FOWNER, CAP_KILL,
#   CAP_AUDIT_WRITE, CAP_SYS_CHROOT. Широких capability (CAP_SYS_ADMIN,
#   CAP_NET_ADMIN, CAP_SYS_PTRACE и т.п.) в нём нет, так что компрометация
#   панели по-прежнему ограничена sudo-allowlist'ом.
#
# Почему NoNewPrivileges=no:
#   NoNewPrivileges=yes запрещает повышение привилегий через execve setuid-
#   бинарников, а /usr/bin/sudo именно setuid-root. С этим флагом панель
#   получила бы от sudo «The "no new privileges" flag is set, which prevents
#   sudo from running as root», и кнопки перезапуска/обновления сломались бы.
#   Остальные ограничения (узкий CapabilityBoundingSet, ProtectSystem=strict,
#   ProtectHome, PrivateTmp, RestrictAddressFamilies и sudo-allowlist без
#   wildcard) остаются в силе.
#
# Почему ProtectSystem=strict и ReadWritePaths только три пути:
#   панель не должна писать в /etc, /opt, /usr — это делает установщик от
#   root. Единственное, что ей реально нужно на запись: каталог списков
#   (/etc/routeweave/lists — правка/загрузка dpi.txt), /run (рантайм-файлы,
#   например /run/routeweave) и /var/log/routeweave (снимки диагностики).
#   ProtectSystem=strict делает всю остальную ФС read-only, ReadWritePaths
#   открывает ровно эти пути. Снимок пишет root-helper, запущенный панелью
#   через `sudo -n`: он наследует mount-namespace этого юнита, поэтому без
#   пути в списке запись в /var/log/routeweave невозможна. Читает снимки сама
#   панель как группа routeweave (каталог 0750 root:routeweave, файлы 0640).
#   Префикс "-" у /var/log/routeweave — для установок, где каталога ещё нет:
#   иначе systemd не запустил бы юнит на старой системе.
#
# PANEL_PORT и PANEL_BIND берутся из EnvironmentFile: app.py читает их через
# os.environ/.env и сам передаёт в uvicorn. ExecStart запускает app.py без
# флагов хоста и без флагов воркеров: адрес прослушивания задаёт PANEL_BIND
# (по умолчанию SERVER_IP, иначе 127.0.0.1), а ровно один воркер обязателен —
# состояние JOB и кэш /api/status живут в памяти процесса.
#
# MemoryMax/TasksMax — предохранитель от утечек и размножения потоков
# (uvicorn + threadpool + sudo-helper'ы): панель не должна съесть память
# шлюза, даже если её начнут дёргать непрерывно.

[Unit]
Description=Routeweave panel (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=routeweave
Group=routeweave
EnvironmentFile=/etc/routeweave/.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/routeweave-panel
ExecStart=/opt/routeweave-panel/venv/bin/python app.py
Restart=on-failure
RestartSec=3
MemoryMax=256M
TasksMax=64
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/routeweave/lists /run -/var/log/routeweave
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_KILL CAP_AUDIT_WRITE CAP_SYS_CHROOT

[Install]
WantedBy=multi-user.target
