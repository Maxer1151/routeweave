[Unit]
Description=Routeweave web panel
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/routeweave/.env
WorkingDirectory=/opt/routeweave-panel
ExecStart=/bin/sh -c 'exec /opt/routeweave-panel/venv/bin/uvicorn app:app --host 0.0.0.0 --port "${PANEL_PORT}"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
